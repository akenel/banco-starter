# Secrets — NEVER commit a real .env
#
# ALL FOUR SHAPES, and the reason is that `.env` alone is not a rule, it is a
# single filename. Proven with `git check-ignore` on 2026-09-17, on this repo,
# which is PUBLIC: `.env` was covered and `.env.bak`, `prod.env`, `staging.env`,
# `.env.production`, `backup.env.old` and `secrets.env` were all WAVED THROUGH.
# Nothing had actually leaked — `.env.example` is the only tracked env file — but
# the next person to type `cp .env .env.bak` before an edit would have committed
# the shop's database password, its Keycloak admin password and its B2 keys.
#
# Re-prove it after any change, never assume:
#   for f in .env .env.bak prod.env staging.env .env.production backup.env.old #            secrets.env .env.example; do
#     printf '%-20s ' "$f"; git check-ignore -q "$f" && echo IGNORED || echo NOT; done
#   → every one IGNORED except .env.example, which must stay committed.
.env
*.env
.env.*
*.env.*
!.env.example
*.env.local

# Personalized onboarding copies that may hold real passwords/keys — keep out of git
*.local.md
*.filled.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Backups / data pulled locally (restore-from-b2.sh works in a /tmp mktemp dir,
# so no loose .sql lands here; do NOT blanket-ignore *.sql — it hides the source
# SQL under scripts/db/ that the stand-up needs).
*.sql.gz
*.sql.gz.gpg
*.dump

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Build stamp — generated at build time from git (see scripts/rebuild.sh + Dockerfile)
src/static/build-sha.txt

# Generated prod reverse-proxy config (from scripts/go-live.py; Caddyfile.example is the reference)
/Caddyfile

# Local pre-deploy dumps (--local-only). Encrypted, but never in git.
backups/

# Claude Code personal overrides (machine-specific; never published)
.claude/settings.local.json

# EAN-match working data — REAL SHOP DATA (product ids, names, EANs) for a third party.
# banco-starter is a PUBLIC repo; none of this belongs in it. The tool regenerates it.
scripts/ean-match/data/
scripts/ean-match/work/
